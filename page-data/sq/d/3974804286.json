{"data":{"allMarkdownRemark":{"nodes":[{"frontmatter":{"Email":"eolanrew@uh.edu","date":"2023-01-02T00:00:00.000Z","name":"Emmanuel A. Olanrewaju","photo":"people/alumni/photo/Emmanuel_Olanrewaju.jpg","description":"Emmanuel loves computational work to understand and design materials for renewable energy applications. He currently works on data-driven understanding of the stability of zeolites."},"id":"81102c23-c004-5c22-b328-b1f4e1509f79"},{"frontmatter":{"Email":"whuang25@uh.edu","date":"2023-01-01T00:00:00.000Z","name":"Wei-Fan Huang","photo":"people/alumni/photo/Wei-Fan_Huang.jpg","description":"Wei-Fan received his B.S. and M.S. in Chemical Engineering from National Cheng Kung University in Taiwan in 2018 and 2021. His research focuses on developing machine learning models and their applications in molecular simulation of battery materials."},"id":"13ead819-4b41-5812-8f14-2acf781a6fd5"},{"frontmatter":{"Email":"2024020901017@std.uestc.edu.cn","date":"2025-09-03T00:00:00.000Z","name":"Linda Li (李林达)","photo":"people/alumni/photo/Linda_Li.jpg","description":"A UESTCer from Northeast China. If you are patient, warmhearted, and make occasional mistakes (just like me), then we can be friends."},"id":"d6e69d32-78c0-5310-b03a-316cd1c52f36"},{"frontmatter":{"Email":"2024270903001@std.uestc.edu.cn","date":"2025-09-04T00:00:00.000Z","name":"Yaqi Song (宋亚琪)","photo":"people/alumni/photo/Yaqi_Song.jpg","description":"Yaqi is an undergraduate student in the Honors College at UESTC. With a strong interest in AI, she is eager to contribute to innovative research in the field."},"id":"8dcbcef9-04cb-56b5-941c-13b9254ca691"},{"frontmatter":{"Email":"2024270902013@std.uestc.edu.cn","date":"2025-09-05T00:00:00.000Z","name":"Jiayuan Sun (孙嘉远)","photo":"people/alumni/photo/Jiayuan_Sun.jpg","description":"Jiayuan is a sophomore interested in interdisciplinary applications of AI in scientific research. He hopes to gain practical experience and contribute to the development of relevant research projects."},"id":"7c887ef1-e987-527e-9de2-6c45e4efc92f"},{"frontmatter":{"Email":"jdai9@central.uh.edu","date":"2023-11-13T00:00:00.000Z","name":"Jin Dai","photo":"people/alumni/photo/Jin.png","description":"Joined CATL (宁德时代) after leaving the group. Jin received her PhD in Materials Science Engineering from Michigan State Univerisy in 2023. Her research focuses on exploring the interfacial properties between electrodes and solid electrolytes using simulation techniques."},"id":"ad6bc893-5517-5d1b-9f17-ed442daea1f6"},{"frontmatter":{"Email":"sadhik22@central.uh.edu","date":"2023-06-01T00:00:00.000Z","name":"Santosh Adhikari","photo":"people/alumni/photo/SA_headshot.png","description":"Joined PsiQuantum after leaving the group. Santosh received his PhD in Physics (spring, 2021) from Temple University. He is interested in machine learning-assisted understanding and discovery of novel materials."},"id":"137e389e-f7d5-5763-9b5d-e18835e57d3f"}]},"allFile":{"nodes":[{"relativePath":"people/alumni/photo/Dale_Green.jpg","extension":"jpg","publicURL":"/static/8c6daf81bdb3204df6446d018c2e2108/Dale_Green.jpg","childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#687878","images":{"fallback":{"src":"/static/8c6daf81bdb3204df6446d018c2e2108/e10c2/Dale_Green.jpg","srcSet":"/static/8c6daf81bdb3204df6446d018c2e2108/8bb35/Dale_Green.jpg 125w,\n/static/8c6daf81bdb3204df6446d018c2e2108/684fe/Dale_Green.jpg 250w,\n/static/8c6daf81bdb3204df6446d018c2e2108/e10c2/Dale_Green.jpg 499w","sizes":"(min-width: 499px) 499px, 100vw"},"sources":[{"srcSet":"/static/8c6daf81bdb3204df6446d018c2e2108/d66e1/Dale_Green.webp 125w,\n/static/8c6daf81bdb3204df6446d018c2e2108/8e3ea/Dale_Green.webp 250w,\n/static/8c6daf81bdb3204df6446d018c2e2108/3741b/Dale_Green.webp 499w","type":"image/webp","sizes":"(min-width: 499px) 499px, 100vw"}]},"width":499,"height":500}}},{"relativePath":"people/alumni/photo/Emmanuel_Olanrewaju.jpg","extension":"jpg","publicURL":"/static/15351159