{"data":{"allMarkdownRemark":{"nodes":[{"frontmatter":{"Email":"sadhik22@central.uh.edu","date":"2023-06-01T00:00:00.000Z","name":"Santosh Adhikari","photo":"people/alumni/photo/SA_headshot.png","description":"Joined PsiQuantum after leaving the group. Santosh received his PhD in Physics (spring, 2021) from Temple University. He is interested in machine learning-assisted understanding and discovery of novel materials."},"id":"137e389e-f7d5-5763-9b5d-e18835e57d3f"},{"frontmatter":{"Email":"jdai9@central.uh.edu","date":"2023-11-13T00:00:00.000Z","name":"Jin Dai","photo":"people/alumni/photo/Jin.png","description":"Joined CATL (宁德时代) after leaving the group. Jin received her PhD in Materials Science Engineering from Michigan State Univerisy in 2023. Her research focuses on exploring the interfacial properties between electrodes and solid electrolytes using simulation techniques."},"id":"ad6bc893-5517-5d1b-9f17-ed442daea1f6"},{"frontmatter":{"Email":"2024020901017@std.uestc.edu.cn","date":"2025-09-03T00:00:00.000Z","name":"Linda Li (李林达)","photo":"people/alumni/photo/Linda_Li.jpg","description":"A UESTCer from Northeast China. If you are patient, warmhearted, and make occasional mistakes (just like me), then we can be friends."},"id":"d6e69d32-78c0-5310-b03a-316cd1c52f36"},{"frontmatter":{"Email":"2024270903001@std.uestc.edu.cn","date":"2025-09-04T00:00:00.000Z","name":"Yaqi Song (宋亚琪)","photo":"people/alumni/photo/Yaqi_Song.jpg","description":"Yaqi is an undergraduate student in the Honors College at UESTC. With a strong interest in AI, she is eager to contribute to innovative research in the field."},"id":"8dcbcef9-04cb-56b5-941c-13b9254ca691"},{"frontmatter":{"Email":"2024270902013@std.uestc.edu.cn","date":"2025-09-05T00:00:00.000Z","name":"Jiayuan Sun (孙嘉远)","photo":"people/alumni/photo/Jiayuan_Sun.jpg","description":"Jiayuan is a sophomore interested in interdisciplinary applications of AI in scientific research. He hopes to gain practical experience and contribute