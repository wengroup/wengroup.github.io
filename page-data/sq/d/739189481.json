{"data":{"allMarkdownRemark":{"nodes":[{"frontmatter":{"Email":"202521210106@std.uestc.edu.cn","name":"Jiahui Pan (潘佳荟)","date":"2025-09-01T00:00:00.000Z","photo":"people/master/photo/Jiahui_Pan.jpg","description":"Jiahui is dedicated to applying molecular dynamics to study battery materials, aiming to deepen the understanding of electrochemical processes and improve battery performance."},"id":"0f2e9946-1457-5d70-b170-bd9832c24aa5"},{"frontmatter":{"Email":"202522020823@std.uestc.edu.cn","name":"Haoyang Wang (汪浩洋)","date":"2025-09-02T00:00:00.000Z","photo":"people/master/photo/Haoyang_Wang.png","description":"Haoyang holds a B.S. in Space Physics from the University of Science and Technology of China. His research focuses on the application of first-principles theory to study and design magnetic materials."},"id":"bb57b8cc-a0a4-574a-99c2-b92b81d1de07"},{"frontmatter":{"Email":"202621210422@std.uestc.edu.cn","name":"Junfei Yang (杨俊飞)","date":"2026-09-21T00:00:00.000Z","photo":"people/master/photo/Junfei_Yang.jpg","description":"Junfei obtained his bachelor's degree from UESTC. He uses machine learning atomistic simulations to understand how materials grow in processes like remote epitaxy."},"id":"216e1c35-dee4-5379-be21-599f121b4987"},{"frontmatter":{"Email":"202621210421@std.uestc.edu.cn","name":"Ran Zhang (张冉)","date":"2026-09-21T00:00:00.000Z","photo":"people/master/photo/Ran_Zhang.jpg","description":"Ran studies porous materials for energy applications. She uses computational modeling and machine learning to understand these materials at a fundamental level and to design new ones."},"id":"774e2aff-0ec7-5cb0-b1bb-08c600c504c5"}]},"allFile":{"nodes":[{"relativePath":"people/master/photo/Junfei_Yang.jpg","extension":"jpg","publicURL":"/static/c35cece0f6f6542c5fdaa987bf7b8564/Junfei_Yang.jpg","childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#d8b888","images":{"fallback":{"src":"/static/c35cece0f6f6542c5fdaa987bf7b8564/df3b3/Junfei_Yang